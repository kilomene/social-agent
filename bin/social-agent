    p = sc_sub.add_parser("add", help="register a job")
    p.add_argument("name")
    p.add_argument("--kind", required=True, choices=("once", "interval", "daily"),
                   help="once: --spec ISO run_at; interval: --spec seconds; daily: --spec HH:MM")
    p.add_argument("--spec", default="")
    p.add_argument("--payload", default="", help="JSON payload")
    p = sc_sub.add_parser("list", help="list jobs")
    p.add_argument("--status", default=None)
    p = sc_sub.add_parser("enable", help="enable a job")
    p.add_argument("name")
    p = sc_sub.add_parser("disable", help="disable a job")
    p.add_argument("name")

                                              args.a, args.b)
            print(f"experiment {name!r} started: A={args.a!r} vs B={args.b!r}")
        elif args.eop == "list":
            for e in study_mod.list_experiments(home_dir()):
                print(f"{e['name']} [{e['status']}] {e['kind']}: "
                      f"A={e['variant_a']!r} vs B={e['variant_b']!r}"
                      + (f" winner={e['winner']}" if e.get("winner") else ""))
        elif args.eop == "conclude":
            exp = study_mod.conclude_experiment(home_dir(), args.name,
                                                args.metric_a, args.metric_b)
            print(f"experiment {args.name!r} concluded: A={exp['metric_a']} "
                  f"B={exp['metric_b']} winner={exp['winner']}")


def _csv_list(s):
    return [x.strip() for x in (s or "").split(",") if x.strip()]


def cmd_identity(args):
    if args.op == "create":
        acct = resolve_account(args.account)
        label = acct.get("label") or acct["username"]
        meta = {"name": args.name,
                "voice_traits": _csv_list(args.voice_traits),
                "known_facts": _csv_list(args.facts),
                "opinions": _csv_list(args.opinions),
                "never_say": _csv_list(args.never_say)}
        p = identity_mod.persona_path(home_dir(), label)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w", encoding="utf-8") as fh:
            fh.write("---\n")
            fh.write(f"name: {json.dumps(args.name)}\n")
            for key, val in (("voice_traits", _csv_list(args.voice_traits)),
                             ("known_facts", _csv_list(args.facts)),
                             ("opinions", _csv_list(args.opinions)),
                             ("never_say", _csv_list(args.never_say))):
                fh.write(f"{key}:\n")
                for item in val:
                    fh.write(f"  - {json.dumps(item)}\n")
            fh.write("---\n\n" + (args.notes or "Persona notes for "
                                  f"{args.name}. Edit freely."))
        print(f"persona created for {label} at {p}")
    elif args.op == "show":
        acct = resolve_account(args.account)
        label = acct.get("label") or acct["username"]
        meta, body = identity_mod.load_persona(home_dir(), label)
        if meta is None:
            print(f"no persona on file for {label!r}")
            return
        print(f"persona for {label} (owner: {meta.get('name', '?')})")
        for k in ("voice_traits", "known_facts", "opinions", "never_say"):
            vals = identity_mod._as_list(meta.get(k))
            if vals:
                print(f"  {k}: {', '.join(vals)}")
        if body:
            print(f"\n{body}")
    elif args.op == "check":
        acct = resolve_account(args.account)
        label = acct.get("label") or acct["username"]
        res = identity_mod.check_identity(args.text, label, home_dir())
        if res["pass"]:
            print(f"identity check PASSED for {label}")
        else:
            print(f"identity check FAILED for {label}", file=sys.stderr)
            for r in res["reasons"]:
                print(f"  - {r}", file=sys.stderr)
            sys.exit(2)
        for a in res["advisories"]:
            print(f"note: {a}")


# -------------------------------------------------------------- moderate ---

def _moderation_log():
    return load_json("moderation.json", [])


def cmd_moderate(args):
    if args.op == "scan":
        check_platform(args.platform)
        resolve_account(args.account)
        tos_mod.check_tos(args.platform, "automated_data_collection")
        if not args.fixture:
            raise UsageError("moderate scan needs --fixture (JSON list of comments)")
        with open(args.fixture, encoding="utf-8") as fh:
            data = json.load(fh)
        if isinstance(data, dict):
            data = data.get("items", [])
        for it in data:
            cls = mod_classify.classify_comment(str(it.get("text", "")))
            print(f"{it.get('id')} [{cls['label']}] @{it.get('author')}: "
                  f"{str(it.get('text', ''))[:90]}")
            print(f"    score {cls['score']}: {'; '.join(cls['reasons'][:3])}")
    elif args.op == "hide":
        check_platform(args.platform)
        acct = resolve_account(args.account)
        guard_acting(args.platform, "hide")
        text = args.text or ""
        cls = mod_classify.classify_comment(text)
        rules = get_policy().get("moderation", {}).get("auto_hide", [])
        rule = mod_classify.check_auto_hide(text, rules)
        log = _moderation_log()
        mid = new_id("m")
        rec = {
            "id": mid, "action": "hide", "platform": args.platform,
            "account": acct["username"], "post": args.post,
            "comment": args.comment, "text": text[:200],
            "classification": cls["label"], "reason": args.reason or "",
            "dry_run": True, "created": utcnow(),
        }
        if rule:
            rec.update({"status": "approved", "auto_approved": True,
                        "auto_hide_rule": rule,
                        "approved_at": utcnow(), "approved_at_ts": time.time()})
            print(f"hide {mid} AUTO-APPROVED under pre-approved rule "
                  f"{rule['label']!r} ({rule['reason']})")
        else:
            rec.update({"status": "proposed", "auto_approved": False})
            print(f"DRY-RUN proposal {mid}: hide comment {args.comment} "
                  f"[{args.platform}/{acct['username']}] ({cls['label']})")
            print("Nothing was hidden. Run `moderate approve` to approve it explicitly.")
        record_action(args.platform)
        log.append(rec)
        save_json("moderation.json", log)
    elif args.op == "list":
        log = _moderation_log()
        if args.status:
            log = [m for m in log if m["status"] == args.status]
        if not log:
            print("no hide proposals")
            return
        for m in log:
            print(f"{m['id']} [{m['status']}] hide {m['comment']} "
                  f"({m['classification']}) [{m['platform']}/{m['account']}]")
    elif args.op == "approve":
        log = _moderation_log()
        m = next((x for x in log if x["id"] == args.id), None)
        if not m:
            raise UsageError(f"unknown proposal {args.id!r}")
        if m["status"] != "proposed":
            raise UsageError(f"proposal {args.id} is {m['status']}, not proposed")
        guard_acting(m["platform"], "hide")
        m["status"] = "approved"
        m["approved_at"] = utcnow()
        m["approved_at_ts"] = time.time()
        save_json("moderation.json", log)
        print(f"hide {args.id} APPROVED for {m['platform']}/{m['account']}")
        print("Hide the comment in a real browser session, then `moderate done`.")
    elif args.op == "done":
        log = _moderation_log()
        m = next((x for x in log if x["id"] == args.id), None)
        if not m:
            raise UsageError(f"unknown proposal {args.id!r}")
        if m["status"] != "approved":
            raise UsageError(f"proposal {args.id} is {m['status']}; approve it first")
        if not approval_valid(m):
            m["status"] = "expired"
            save_json("moderation.json", log)
            raise Refused("approval expired; re-approve")
        m["status"] = "done"
        m["done_at"] = utcnow()
        save_json("moderation.json", log)
        print(f"hide {args.id} logged as done")


# --------------------------------------------------------------- caption ---

def cmd_caption(args):
    check_platform(args.platform)
    label = ""
    if args.account:
        acct = resolve_account(args.account)
        label = acct.get("label") or acct["username"]
    extra = _csv_list(args.hashtags)
    if args.op == "generate":
        cap = captions_mod.generate(args.platform, args.topic, args.tone,
                                    extra_hashtags=extra)
        _warn(content_gates(args.platform, label, cap["caption"], "caption"))
        print(cap["caption"])
        print(f"\n[{cap['char_count']} chars | {len(cap['hashtags'])} hashtags | "
              f"tone={cap['tone']}]")
    elif args.op == "variants":
        for i, cap in enumerate(captions_mod.variants(args.platform, args.topic,
                                                      args.tone, n=args.n,
                                                      extra_hashtags=extra), 1):
            _warn(content_gates(args.platform, label, cap["caption"],
                                f"caption_variant_{i}"))
            print(f"--- variant {i} ---")
            print(cap["caption"])
            print()


# ----------------------------------------------------------------- video ---

def _require_ffmpeg():
    path = vff.which_ffmpeg()
    if not path:
        raise UsageError("ffmpeg not found — see video/SETUP.md for install steps")
    return path


def cmd_video(args):
    dry = bool(getattr(args, "dry_run", False))
    if args.op == "info":
        inf = vff.info(args.input)
        print(f"duration : {inf.get('duration', 0):.2f}s")
        print(f"size     : {inf.get('width')}x{inf.get('height')} "
              f"@{inf.get('fps')}fps [{inf.get('vcodec')}]")
        print(f"audio    : {inf.get('acodec', 'none')}")
    elif args.op == "clip":
        _require_ffmpeg()
        vff.run_cmd(vff.build_clip(args.input, args.output, args.start,
                                   args.duration, strict=not dry), dry_run=dry)
        if not dry:
            print(f"clipped -> {args.output}")
    elif args.op == "trim":
        _require_ffmpeg()
        vff.run_cmd(vff.build_trim(args.input, args.output, args.start, args.end,
                        strict=not dry), dry_run=dry)
        if not dry:
            print(f"trimmed -> {args.output}")
    elif args.op == "concat":
        _require_ffmpeg()
        inputs = [p.strip() for p in (args.inputs or "").split(",") if p.strip()]
        vff.run_cmd(vff.build_concat(inputs, args.output, strict=not dry), dry_run=dry)
        if not dry:
            print(f"concatenated {len(inputs)} files -> {args.output}")
    elif args.op == "to-vertical":
        _require_ffmpeg()
        vff.run_cmd(vff.build_to_vertical(args.input, args.output, strict=not dry), dry_run=dry)
        if not dry:
            print(f"vertical 9:16 -> {args.output}")
    elif args.op == "to-horizontal":
        _require_ffmpeg()
        vff.run_cmd(vff.build_to_horizontal(args.input, args.output, strict=not dry), dry_run=dry)
        if not dry:
            print(f"horizontal 16:9 -> {args.output}")
    elif args.op == "frame":
        _require_ffmpeg()
        vff.run_cmd(vff.build_frame(args.input, args.output, at=args.at,
                        strict=not dry), dry_run=dry)
        if not dry:
            print(f"frame @ {args.at}s -> {args.output}")
    elif args.op == "compress":
        _require_ffmpeg()
        vff.run_cmd(vff.build_compress(args.input, args.output, args.preset,
                        strict=not dry), dry_run=dry)
        if not dry:
            print(f"compressed [{args.preset}] -> {args.output}")
    elif args.op == "plan":
        if args.pop == "create":
            steps = json.loads(args.steps)
            plan = vplans.create(home_dir(), args.name, steps,
                                 description=args.description or "")
            print(f"plan {args.name!r} created with {len(plan['steps'])} step(s)")
        elif args.pop == "list":
            names = vplans.list_plans(home_dir())
            print("no plans" if not names else "\n".join(names))
        elif args.pop == "show":
            plan = vplans.load(home_dir(), args.name)
            print(json.dumps(plan, indent=2))
        elif args.pop == "run":
            _require_ffmpeg()
            vplans.run(home_dir(), args.name, args.input, args.output,
                       dry_run=dry)
            if not dry:
                print(f"plan {args.name!r} executed -> {args.output}")


# ----------------------------------------------------------------- audio ---

def cmd_audio(args):
    dry = bool(getattr(args, "dry_run", False))
    if args.op == "clip":
        _require_ffmpeg()
        audio_mod.run_cmd(audio_mod.build_clip(args.input, args.output, args.start,
                                               args.duration, args.fade_in,
                                               args.fade_out, strict=not dry), dry_run=dry)
        if not dry:
            print(f"audio clipped -> {args.output}")
    elif args.op == "loop":
        _require_ffmpeg()
        audio_mod.run_cmd(audio_mod.build_loop(args.input, args.output,
                                               args.duration, strict=not dry), dry_run=dry)
        if not dry:
            print(f"audio looped to {args.duration}s -> {args.output}")
    elif args.op == "mix":
        _require_ffmpeg()
        audio_mod.run_cmd(audio_mod.build_mix(args.voiceover, args.bed,
                                              args.output, args.duck_db,
                                              strict=not dry), dry_run=dry)
        if not dry:
            print(f"mixed (bed ducked {args.duck_db}dB) -> {args.output}")
    elif args.op == "extract":
        _require_ffmpeg()
        audio_mod.run_cmd(audio_mod.build_extract(args.video, args.output,
                                              strict=not dry), dry_run=dry)
        if not dry:
            print(f"audio extracted -> {args.output}")
    elif args.op == "normalize":
        _require_ffmpeg()
        audio_mod.run_cmd(audio_mod.build_normalize(args.input, args.output,
                                                    args.preset, strict=not dry), dry_run=dry)
        if not dry:
            print(f"normalized [{args.preset}] -> {args.output}")


def cmd_doctor(args):
    checks = []

    def check(name, ok, detail=""):
        checks.append((name, ok, detail))

    check("python >= 3.8", sys.version_info >= (3, 8), sys.version.split()[0])
    try:
        os.makedirs(home_dir(), exist_ok=True)
        probe = os.path.join(home_dir(), ".writetest")
        with open(probe, "w") as fh:
            fh.write("ok")
        os.remove(probe)
        check("state dir writable", True, home_dir())
    except OSError as e:
        check("state dir writable", False, str(e))
    try:
        pol = get_policy()
        check("policy.yaml parses", True, f"version {pol.get('version')}")
    except Exception as e:
        check("policy.yaml parses", False, str(e))
    for p in SUPPORTED_PLATFORMS:
        try:
            get_adapter(p)
            check(f"platform adapter: {p}", True)
        except Exception as e:
            check(f"platform adapter: {p}", False, str(e))
    try:
        n = 0
        for p in SUPPORTED_PLATFORMS:
            tos_mod.load_rules(p)
            n += 1
        check("ToS rules parse", True, f"{n} platforms")
    except Exception as e:
        check("ToS rules parse", False, str(e))
    check("watcher types", True, ", ".join(sorted(REGISTRY)))
    fx = os.path.join(REPO_ROOT, "watchers", "fixtures")
    nfx = len([f for f in os.listdir(fx) if f.endswith(".json")]) if os.path.isdir(fx) else 0
    check("sample fixtures", nfx > 0, f"{nfx} fixture files")
    check("credentials stored in repo", False, "good: none (by design)")
    try:
        import missions as _m  # noqa: F401
        check("missions module", True, _m.missions_dir())
    except Exception as e:
        check("missions module", False, str(e))
    try:
        from heartbeat import pinger as _hb
        hcfg = _hb.load_config()
        check("heartbeat config", True,
              f"enabled={hcfg.enabled} base_url={'set' if hcfg.base_url else 'log-only'}")
    except Exception as e:
        check("heartbeat config", False, str(e))
    ff = vff.which_ffmpeg()
    check("ffmpeg (video/audio editing)", bool(ff), ff or "not found — see video/SETUP.md")
    check("ffprobe (video info)", bool(vff.ffprobe()),
          vff.ffprobe() or "not found — see video/SETUP.md")
    for modname, desc in (("moderation.classify", "comment moderation"),
                          ("captions.generate", "caption generator"),
                          ("video.ffmpeg", "video command builders"),
                          ("video.plans", "video edit plans"),
                          ("audio.clips", "audio clipping/mixing")):
        try:
            __import__(modname)
            check(f"module: {desc}", True)
        except Exception as e:
            check(f"module: {desc}", False, str(e))

    failed = 0
    for name, ok, detail in checks:
        # the credentials check is inverted: ok=False is the desired state
        good = ok if name != "credentials stored in repo" else not ok
        mark = "ok  " if good else "FAIL"
        if not good:
            failed += 1
        print(f"[{mark}] {name}" + (f" — {detail}" if detail else ""))
    if failed:
        raise UsageError(f"{failed} check(s) failed")
    print("doctor: all checks passed")



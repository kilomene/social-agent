            print(f"WARNING: score below threshold {voice_check_mod.WARN_THRESHOLD}",
                  file=sys.stderr)
    elif args.op == "guide":
        p = os.path.join(REPO_ROOT, "voice", "guide.md")
        with open(p, encoding="utf-8") as fh:
            print(fh.read())



def main(argv=None):
    raw = list(sys.argv[1:] if argv is None else argv)
    # `editor` accepts --dry-run anywhere in its argv (leaf parsers don't
    # redeclare it, unlike video/audio): hoist it before parsing.
    ed_dry = False
    if raw[:1] == ["editor"] and "--dry-run" in raw:
        raw = [a for a in raw if a != "--dry-run"]
        ed_dry = True
    args = build_parser().parse_args(raw)
    if ed_dry:
        args.dry_run = True
    try:
        args.func(args)
    except tos_mod.ToSRefusal as e:
        print(f"REFUSED (ToS): {e}", file=sys.stderr)
        return 2
    except Refused as e:
        print(f"REFUSED (policy): {e}", file=sys.stderr)
        return 2
    except UsageError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    except WatcherError as e:
        print(f"watcher error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

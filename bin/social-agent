#!/usr/bin/env python3
"""social-agent: autonomous social-media monitoring toolkit (offline-capable CLI).

Safety model (see policy/guardrails.md):
  * Watchers are READ-ONLY: they observe and PROPOSE, never act alone.
  * Acting operations (post, like, comment, follow, retweet, DM) are created
    as dry-run proposals and require an explicit per-action approval record.
  * Per-platform rate limits and quiet hours are enforced by this CLI.
  * No credentials are ever stored. State lives in $SOCIAL_AGENT_HOME
    (default ~/.social-agent) as plain JSON.

Everything works offline: watchers poll fixture files, engagement actions are
proposed/approved/logged here, and live execution happens in a real browser
session driven by the user or their agent.
"""

import argparse
import json
import os
import random
import sys
import time
from datetime import datetime, timezone

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from policy import yaml_lite
from platforms.base import get_adapter, SUPPORTED_PLATFORMS
from platforms import tos as tos_mod
from watchers import REGISTRY, WatcherError
from engagement import interest as interest_mod
from heartbeat import pinger as hb
import missions as missions_mod
import autonomy as autonomy_mod

VERSION = "0.1.0"


class Refused(Exception):
    """Policy refusal: rate limit hit, quiet hours, or missing approval."""


class UsageError(Exception):
    """Bad input: unknown id, bad config, missing account."""


# ---------------------------------------------------------------- state ---

def home_dir():
    return os.environ.get("SOCIAL_AGENT_HOME", os.path.expanduser("~/.social-agent"))


def _path(name):
    return os.path.join(home_dir(), name)


def load_json(name, default):
    p = _path(name)
    if not os.path.exists(p):
        return default
    with open(p, encoding="utf-8") as fh:
        return json.load(fh)


def save_json(name, data):
    os.makedirs(home_dir(), exist_ok=True)
    p = _path(name)
    tmp = p + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
    os.replace(tmp, p)


def utcnow():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def new_id(prefix):
    return f"{prefix}-{random.randrange(16 ** 6):06x}"


def read_events():
    p = _path("events.jsonl")
    if not os.path.exists(p):
        return []
    out = []
    with open(p, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if line:
                out.append(json.loads(line))
    return out


# --------------------------------------------------------------- policy ---

_policy_cache = None


def policy_path():
    return os.environ.get("SOCIAL_AGENT_POLICY",
                          os.path.join(REPO_ROOT, "policy", "policy.yaml"))


def get_policy():
    global _policy_cache
    if _policy_cache is None:
        _policy_cache = yaml_lite.load(policy_path())
    return _policy_cache


def check_rate_limit(platform):
    pol = get_policy()["rate_limits"]
    lim = pol.get(platform, pol["default"])
    now = time.time()
    log = load_json("ratelimit.json", {}).get(platform, [])
    log = [t for t in log if now - t < 86400]
    hour = [t for t in log if now - t < 3600]
    if len(hour) >= lim["actions_per_hour"]:
        raise Refused(
            f"rate limit: {platform} hourly cap ({lim['actions_per_hour']}) reached")
    if len(log) >= lim["actions_per_day"]:
        raise Refused(
            f"rate limit: {platform} daily cap ({lim['actions_per_day']}) reached")


def record_action(platform):
    log = load_json("ratelimit.json", {})
    log.setdefault(platform, []).append(time.time())
    save_json("ratelimit.json", log)


def in_quiet_hours(now=None):
    qh = get_policy()["quiet_hours"]
    if not qh.get("enabled"):
        return False
    now = now or datetime.now().astimezone()
    s, e = qh["start"], qh["end"]
    cur = now.strftime("%H:%M")
    if s <= e:
        return s <= cur < e
    return cur >= s or cur < e


def guard_acting(platform, action):
    """Gate every acting operation.

    Layer order (ToS is the ceiling — nothing below can override it):
      1. Platform Terms of Service (platforms/<name>/tos_rules.yaml)
      2. Quiet hours + rate limits
    Mission scope / autonomy is checked by the caller after this gate.
    """
    tos_class = tos_mod.CLI_OP_TO_CLASS.get(action)
    if tos_class is None:
        raise Refused(f"no ToS classification for action {action!r}; refusing by default")
    try:
        tos_mod.check_tos(platform, tos_class)
    except tos_mod.ToSRefusal as e:
        log_refusal(action, platform, "", f"ToS: {e}")
        raise
    if in_quiet_hours():
        raise Refused("quiet hours active: acting operations are paused")
    check_rate_limit(platform)


def approval_valid(action):
    age_h = (time.time() - action.get("approved_at_ts", 0)) / 3600.0
    return age_h <= get_policy()["approvals"]["expiry_hours"]


def log_refusal(action, platform, target, reason):
    """Append a refusal record (policy said no) to refusals.jsonl."""
    p = _path("refusals.jsonl")
    os.makedirs(home_dir(), exist_ok=True)
    with open(p, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({
            "timestamp": utcnow(), "action": action, "platform": platform,
            "target": target, "reason": reason,
        }) + "\n")


def check_like_guards(platform, author):
    """Anti-spam guards for likes: caps, per-author cooldown, min interval."""
    eng = get_policy().get("engagement", {})
    now = time.time()
    likes = [l for l in load_json("likes.json", []) if l.get("platform") == platform]
    day = [l for l in likes if now - l["ts"] < 86400]
    hour = [l for l in day if now - l["ts"] < 3600]
    cap_h, cap_d = eng.get("likes_per_hour", 20), eng.get("likes_per_day", 100)
    if len(hour) >= cap_h:
        raise Refused(f"like spam guard: {platform} hourly like cap ({cap_h}) reached")
    if len(day) >= cap_d:
        raise Refused(f"like spam guard: {platform} daily like cap ({cap_d}) reached")
    if author:
        cd = eng.get("like_author_cooldown_hours", 24) * 3600
        seen = [l["ts"] for l in likes
                if (l.get("author") or "").lower() == author.lower()]
        if seen and now - max(seen) < cd:
            wait_h = (cd - (now - max(seen))) / 3600
            raise Refused(f"like spam guard: @{author} already liked recently "
                          f"(cooldown {wait_h:.1f}h left)")
    gap = eng.get("min_seconds_between_likes", 60)
    if likes and now - max(l["ts"] for l in likes) < gap:
        wait_s = int(gap - (now - max(l["ts"] for l in likes)))
        raise Refused(f"like spam guard: liking too fast, wait {wait_s}s")


def record_like(platform, author, target):
    likes = load_json("likes.json", [])
    likes.append({"ts": time.time(), "platform": platform,
                  "author": (author or "").lower(), "target": target})
    save_json("likes.json", likes)


def check_follow_guards(platform):
    eng = get_policy().get("engagement", {})
    cap = eng.get("follows_per_day", 30)
    now = time.time()
    follows = [f for f in load_json("follows.json", [])
               if f.get("platform") == platform and now - f["ts"] < 86400]
    if len(follows) >= cap:
        raise Refused(f"follow guard: {platform} daily follow cap ({cap}) reached")


def record_follow(platform, target):
    follows = load_json("follows.json", [])
    follows.append({"ts": time.time(), "platform": platform, "target": target})
    save_json("follows.json", follows)


def autonomous_decision(platform, action, text=""):
    """If autonomy is granted and the action is in mission scope, return the
    mission name (auto-approval applies). If autonomy is granted but the
    action is OUT of scope, raise Refused and log it. If autonomy is not
    granted, return None (normal approval flow)."""
    st = autonomy_mod.load_state()
    if not st.get("granted"):
        return None
    allowed, reason = autonomy_mod.check_scope(platform, action, text)
    if not allowed:
        log_refusal(action, platform, "", f"autonomous scope: {reason}")
        raise Refused(f"autonomous scope block: {reason}")
    try:
        autonomy_mod.check_mission_limit(action)
    except RuntimeError as e:
        log_refusal(action, platform, "", str(e))
        raise Refused(str(e))
    return st.get("mission")


# -------------------------------------------------------------- helpers ---

def resolve_account(ref):
    accounts = load_json("accounts.json", [])
    for a in accounts:
        if a["username"] == ref or a.get("label") == ref:
            return a
    raise UsageError(f"unknown account {ref!r}; see `accounts list`")


def parse_kv(pairs):
    cfg = {}
    for p in pairs or []:
        if "=" not in p:
            raise UsageError(f"bad --set value {p!r}; use key=value")
        k, v = p.split("=", 1)
        try:
            cfg[k] = json.loads(v)
        except (json.JSONDecodeError, ValueError):
            cfg[k] = v
    return cfg


def check_platform(name):
    if name not in SUPPORTED_PLATFORMS:
        raise UsageError(
            f"unknown platform {name!r} (supported: {', '.join(SUPPORTED_PLATFORMS)})")
    return name


# --------------------------------------------------------------- accounts ---

def cmd_accounts(args):
    accounts = load_json("accounts.json", [])
    if args.op == "list":
        if not accounts:
            print("no accounts configured")
            return
        for a in accounts:
            label = f" ({a['label']})" if a.get("label") else ""
            print(f"{a['username']}{label} [{a['platform']}] added {a['added'][:10]}")
    elif args.op == "add":
        check_platform(args.platform)
        if any(a["username"] == args.username and a["platform"] == args.platform
               for a in accounts):
            raise UsageError(f"account {args.username!r} already added for {args.platform}")
        accounts.append({
            "platform": args.platform,
            "username": args.username,
            "label": args.label or "",
            "added": utcnow(),
        })
        save_json("accounts.json", accounts)
        print(f"added {args.username} [{args.platform}]"
              + (f" as {args.label!r}" if args.label else "")
              + " (no credentials stored)")
    elif args.op == "remove":
        before = len(accounts)
        accounts = [a for a in accounts
                    if not (a["username"] == args.ref or a.get("label") == args.ref)]
        if len(accounts) == before:
            raise UsageError(f"unknown account {args.ref!r}")
        save_json("accounts.json", accounts)
        print(f"removed {args.ref}")
    elif args.op == "show":
        a = resolve_account(args.ref)
        adapter = get_adapter(a["platform"]).to_dict()
        print(f"username : {a['username']}")
        print(f"platform : {a['platform']} ({adapter['display']})")
        print(f"label    : {a.get('label') or '-'}")
        print(f"added    : {a['added']}")
        print(f"auth     : {adapter['auth']}")


# ------------------------------------------------------------------ watch ---

def cmd_watch(args):
    registry = load_json("watchers.json", {})
    if args.op == "list":
        if not registry:
            print("no watchers configured")
            return
        for wid, rec in registry.items():
            state = "enabled" if rec.get("enabled") else "stopped"
            print(f"{wid} [{rec['type']}] {rec['platform']}/{rec['account']} ({state})")
    elif args.op == "start":
        if args.type not in REGISTRY:
            raise UsageError(
                f"unknown watcher type {args.type!r} (see: {', '.join(sorted(REGISTRY))})")
        check_platform(args.platform)
        acct = resolve_account(args.account)
        try:
            tos_mod.check_tos(args.platform, "automated_data_collection")
        except tos_mod.ToSRefusal as e:
            log_refusal("watch", args.platform, args.type, f"ToS: {e}")
            raise
        config = parse_kv(args.set)
        cls = REGISTRY[args.type]
        probe = cls("probe", args.platform, acct["username"], config,
                    home_dir(), args.fixture)
        errors = probe.validate_config()
        if errors:
            raise UsageError("invalid config: " + "; ".join(errors))
        wid = args.id or new_id("w")
        if wid in registry:
            raise UsageError(f"watcher id {wid!r} already exists")
        registry[wid] = {
            "id": wid, "type": args.type, "platform": args.platform,
            "account": acct["username"], "config": config,
            "fixture": args.fixture, "enabled": True, "started": utcnow(),
        }
        save_json("watchers.json", registry)
        print(f"started watcher {wid} [{args.type}] on {args.platform}/{acct['username']}")
    elif args.op == "stop":
        rec = registry.get(args.id)
        if not rec:
            raise UsageError(f"unknown watcher {args.id!r}")
        rec["enabled"] = False
        save_json("watchers.json", registry)
        print(f"stopped watcher {args.id}")
    elif args.op == "status":
        ids = [args.id] if args.id else sorted(registry)
        if not ids:
            print("no watchers configured")
            return
        for wid in ids:
            rec = registry.get(wid)
            if not rec:
                raise UsageError(f"unknown watcher {wid!r}")
            sp = _path(f"watchers/{wid}.json")
            st = {}
            if os.path.exists(sp):
                with open(sp, encoding="utf-8") as fh:
                    st = json.load(fh).get("state", {})
            print(f"{wid} [{rec['type']}] {rec['platform']}/{rec['account']}")
            print(f"  enabled={rec.get('enabled')} polls={st.get('polls', 0)} "
                  f"events={st.get('events_found', 0)} last_poll={st.get('last_poll')}")
    elif args.op == "run":
        rec = registry.get(args.id)
        if not rec:
            raise UsageError(f"unknown watcher {args.id!r}")
        try:
            tos_mod.check_tos(rec["platform"], "automated_data_collection")
        except tos_mod.ToSRefusal as e:
            log_refusal("watch", rec["platform"], rec["id"], f"ToS: {e}")
            raise
        if not rec.get("enabled"):
            raise UsageError(f"watcher {args.id} is stopped")
        cls = REGISTRY[rec["type"]]
        w = cls(rec["id"], rec["platform"], rec["account"], rec["config"],
                home_dir(), rec.get("fixture"))
        hb_cfg = hb.load_config()
        try:
            events = hb.watch_run(hb_cfg, rec["id"], w.check)
        except (WatcherError, OSError) as e:
            raise UsageError(str(e))
        print(f"poll ok: {len(events)} new event(s)")
        for ev in events:
            pa = ev.get("proposed_action")
            prop = f" -> proposes: {pa['action']}" if pa else ""
            print(f"  [{ev['severity']}] {ev['kind']}: {ev['summary'][:120]}{prop}")
    elif args.op == "events":
        events = read_events()
        if args.watcher:
            events = [e for e in events if e.get("watcher") == args.watcher]
        events = events[-args.limit:]
        if not events:
            print("no events recorded")
            return
        for ev in events:
            print(f"{ev['timestamp']} {ev['watcher']} [{ev['kind']}] {ev['summary'][:120]}")


# ------------------------------------------------------------------- post ---

def cmd_post(args):
    queue = load_json("queue.json", [])
    if args.op == "draft":
        check_platform(args.platform)
        acct = resolve_account(args.account)
        pid = args.id or new_id("p")
        queue.append({
            "id": pid, "platform": args.platform, "account": acct["username"],
            "text": args.text, "media": args.media or "",
            "status": "draft", "created": utcnow(),
        })
        save_json("queue.json", queue)
        print(f"drafted post {pid} for {args.platform}/{acct['username']}")
    elif args.op == "list":
        items = queue
        if args.status:
            items = [q for q in items if q["status"] == args.status]
        if not items:
            print("no posts")
            return
        for q in items:
            print(f"{q['id']} [{q['status']}] {q['platform']}/{q['account']}: "
                  f"{q['text'][:80]}")
    elif args.op in ("queue", "approve"):
        q = next((x for x in queue if x["id"] == args.id), None)
        if not q:
            raise UsageError(f"unknown post {args.id!r}")
        if args.op == "queue":
            if q["status"] != "draft":
                raise UsageError(f"post {args.id} is {q['status']}, not draft")
            q["status"] = "queued"
            print(f"post {args.id} queued (still needs approval before any publishing)")
        else:
            if q["status"] not in ("draft", "queued"):
                raise UsageError(f"post {args.id} is {q['status']}")
            guard_acting(q["platform"], "post")
            mission = autonomous_decision(q["platform"], "post", q.get("text", ""))
            q["status"] = "approved"
            q["approved_at"] = utcnow()
            q["approved_at_ts"] = time.time()
            q["auto_approved"] = bool(mission)
            q["mission"] = mission
            record_action(q["platform"])
            if mission:
                print(f"post {args.id} AUTO-APPROVED under mission {mission!r} "
                      f"for {q['platform']}/{q['account']}")
            else:
                print(f"post {args.id} APPROVED for {q['platform']}/{q['account']}")
            print("DRY-RUN: publish this in a real browser session; the CLI never posts by itself.")
        save_json("queue.json", queue)


# ----------------------------------------------------------------- engage ---

ENGAGE_ACTIONS = ["like", "comment", "follow", "retweet"]


def _post_info_from_args(args):
    """Build a post dict from engage args for interest scoring. Returns None
    when no post details were supplied (unscored like)."""
    info = {}
    if args.author:
        info["author"] = args.author
    if args.text and args.op == "like":
        info["text"] = args.text
    if args.hashtags:
        info["hashtags"] = [h.strip().lstrip("#") for h in args.hashtags.split(",") if h.strip()]
    if args.likes_count is not None:
        info["likes"] = args.likes_count
    if args.comments_count is not None:
        info["comments"] = args.comments_count
    return info or None


def cmd_engage(args):
    actions = load_json("actions.json", [])
    if args.op in ENGAGE_ACTIONS:
        check_platform(args.platform)
        acct = resolve_account(args.account)
        if args.op == "comment" and not args.text:
            raise UsageError("comment requires --text")
        guard_acting(args.platform, args.op)

        # --- selective engagement: likes only for interesting posts ---
        text_for_scope = args.text or ""
        if args.op == "like":
            post = _post_info_from_args(args)
            if post is not None:
                score, reasons, interesting = interest_mod.score_post(post)
                if not interesting:
                    reason = (f"not interesting (score {score} < "
                              f"threshold {interest_mod.load_profile().get('threshold')})")
                    log_refusal("like", args.platform, args.target, reason)
                    raise Refused(f"selective engagement: {reason}: {'; '.join(reasons)}")
                print(f"interest score {score}: {'; '.join(reasons[:3])}")
            check_like_guards(args.platform, args.author or "")
        if args.op == "follow":
            check_follow_guards(args.platform)

        # --- autonomous mode: auto-approve in scope, block out of scope ---
        mission = autonomous_decision(args.platform, args.op, text_for_scope)
        if mission:
            status, auto = "approved", True
        else:
            status, auto = "proposed", False

        aid = new_id("a")
        actions.append({
            "id": aid, "action": args.op, "platform": args.platform,
            "account": acct["username"], "target": args.target,
            "text": args.text or "", "status": status,
            "auto_approved": auto, "mission": mission,
            "dry_run": True, "created": utcnow(),
            **({"approved_at": utcnow(), "approved_at_ts": time.time()} if auto else {}),
        })
        record_action(args.platform)
        if args.op == "like":
            record_like(args.platform, args.author or "", args.target)
        if args.op == "follow":
            record_follow(args.platform, args.target)
        save_json("actions.json", actions)
        if auto:
            print(f"AUTO-APPROVED {aid} under mission {mission!r}: "
                  f"{args.op} -> {args.target} [{args.platform}/{acct['username']}]")
            print("DRY-RUN: perform it in a real browser session, then `engage done`.")
        else:
            print(f"DRY-RUN proposal {aid}: {args.op} -> {args.target} "
                  f"[{args.platform}/{acct['username']}]")
            print("No action was taken. Run `engage approve` to approve it explicitly.")
    elif args.op == "list":
        items = actions
        if args.status:
            items = [a for a in items if a["status"] == args.status]
        if not items:
            print("no engagement actions")
            return
        for a in items:
            extra = f" {a['text'][:60]!r}" if a.get("text") else ""
            print(f"{a['id']} [{a['status']}] {a['action']} -> {a['target']}"
                  f" [{a['platform']}/{a['account']}] dry_run={a['dry_run']}{extra}")
    elif args.op == "approve":
        a = next((x for x in actions if x["id"] == args.id), None)
        if not a:
            raise UsageError(f"unknown action {args.id!r}")
        if a["status"] != "proposed":
            raise UsageError(f"action {args.id} is {a['status']}, not proposed")
        guard_acting(a["platform"], a["action"])
        a["status"] = "approved"
        a["approved_at"] = utcnow()
        a["approved_at_ts"] = time.time()
        save_json("actions.json", actions)
        print(f"action {args.id} APPROVED: {a['action']} -> {a['target']}")
        print("Perform it in a real browser session, then log it with `engage done`.")
    elif args.op == "done":
        a = next((x for x in actions if x["id"] == args.id), None)
        if not a:
            raise UsageError(f"unknown action {args.id!r}")
        if a["status"] != "approved":
            raise UsageError(f"action {args.id} is {a['status']}; approve it first")
        if not approval_valid(a):
            a["status"] = "expired"
            save_json("actions.json", actions)
            raise Refused(f"approval for {args.id} expired "
                          f"({get_policy()['approvals']['expiry_hours']}h); re-approve")
        a["status"] = "done"
        a["result"] = args.result or "performed in browser session"
        a["done_at"] = utcnow()
        save_json("actions.json", actions)
        print(f"action {args.id} logged as done: {a['result']}")


# --------------------------------------------------------------- research ---

def cmd_research(args):
    plats = [p.strip() for p in args.platforms.split(",")] if args.platforms else SUPPORTED_PLATFORMS
    for p in plats:
        check_platform(p)
    words = [w for w in args.topic.lower().replace("-", " ").split() if w]
    hashtags = ["#" + "".join(words), "#" + words[0]] if words else []
    queries = {}
    for p in plats:
        queries[p] = [
            args.topic,
            f"{args.topic} tutorial",
            f"{args.topic} breakdown",
            " ".join(hashtags),
        ]
    plan = {
        "topic": args.topic,
        "platforms": plats,
        "queries": queries,
        "hashtags": hashtags,
        "suggested_watchers": [
            {"type": "feed", "note": f"feed watcher with keywords={words}"},
            {"type": "follow", "note": "follow watcher on hashtags " + ", ".join(hashtags)},
            {"type": "channel", "note": "channel watcher on relevant channels found during research"},
        ],
        "created": utcnow(),
    }
    plans = load_json("research.json", [])
    plans.append(plan)
    save_json("research.json", plans)
    print(f"research plan for {args.topic!r} (offline: queries to run in browser/API sessions)")
    for p in plats:
        print(f"  {p}:")
        for q in queries[p]:
            print(f"    - {q}")
    print(f"  hashtags: {', '.join(hashtags)}")
    print("  suggested watchers:")
    for s in plan["suggested_watchers"]:
        print(f"    - [{s['type']}] {s['note']}")


# -------------------------------------------------------------- analytics ---

def cmd_analytics(args):
    events = read_events()
    if args.watcher:
        events = [e for e in events if e.get("watcher") == args.watcher]
    if args.days is not None:
        cutoff = time.time() - args.days * 86400
        events = [e for e in events
                  if datetime.fromisoformat(e["timestamp"]).timestamp() >= cutoff]
    print(f"events: {len(events)}")
    if not events:
        return
    by_kind, by_platform, by_watcher = {}, {}, {}
    for e in events:
        by_kind[e.get("kind", "?")] = by_kind.get(e.get("kind", "?"), 0) + 1
        by_platform[e.get("platform", "?")] = by_platform.get(e.get("platform", "?"), 0) + 1
        by_watcher[e.get("watcher", "?")] = by_watcher.get(e.get("watcher", "?"), 0) + 1
    print("by kind:")
    for k, v in sorted(by_kind.items(), key=lambda x: -x[1]):
        print(f"  {k}: {v}")
    print("by platform:")
    for k, v in sorted(by_platform.items(), key=lambda x: -x[1]):
        print(f"  {k}: {v}")
    print("by watcher:")
    for k, v in sorted(by_watcher.items(), key=lambda x: -x[1]):
        print(f"  {k}: {v}")
    proposed = [e for e in events if e.get("proposed_action")]
    print(f"events proposing actions: {len(proposed)}")
    actions = load_json("actions.json", [])
    by_status = {}
    for a in actions:
        by_status[a["status"]] = by_status.get(a["status"], 0) + 1
    print(f"engagement actions: {len(actions)} " +
          ", ".join(f"{k}={v}" for k, v in sorted(by_status.items())))


# ---------------------------------------------------------------- mission ---

def cmd_mission(args):
    if args.op == "create":
        platforms = [p.strip() for p in args.platforms.split(",") if p.strip()]
        for p in platforms:
            check_platform(p)
        topics = [t.strip() for t in (args.topics or "").split(",") if t.strip()]
        actions = [a.strip() for a in args.actions.split(",") if a.strip()]
        limits = parse_kv(args.limit)
        path = missions_mod.create_mission(args.name, platforms, topics, actions,
                                           limits, args.brief or "")
        print(f"mission {args.name!r} created at {path}")
        print(f"  platforms: {', '.join(platforms)}")
        print(f"  topics: {', '.join(topics) or '-'}")
        print(f"  allowed actions: {', '.join(actions)}")
        print("Note: a mission alone grants nothing. Use `autonomy grant` to activate it.")
    elif args.op == "list":
        ms = missions_mod.list_missions()
        if not ms:
            print("no missions defined")
            return
        for m in ms:
            print(f"{m['name']}: platforms=[{', '.join(m['platforms'])}] "
                  f"actions=[{', '.join(m['allowed_actions'])}]")
    elif args.op == "show":
        p = missions_mod.mission_path(args.name)
        if not os.path.exists(p):
            raise UsageError(f"unknown mission {args.name!r}")
        meta, body = missions_mod.parse_mission_file(p)
        print(f"name: {meta['name']}")
        print(f"platforms: {', '.join(meta['platforms'])}")
        print(f"topics: {', '.join(meta.get('topics') or [])}")
        print(f"allowed actions: {', '.join(meta['allowed_actions'])}")
        print(f"limits: {meta.get('limits') or {}}")
        print("---")
        print(body.strip())


# --------------------------------------------------------------- autonomy ---

def cmd_autonomy(args):
    if args.op == "grant":
        meta = missions_mod.get_mission(args.mission)
        if meta is None:
            raise UsageError(f"unknown mission {args.mission!r}; see `mission list`")
        if not args.confirm:
            print("AUTONOMY GRANT — review the scope before confirming:")
            print(f"  mission: {meta['name']}")
            print(f"  platforms: {', '.join(meta['platforms'])}")
            print(f"  topics: {', '.join(meta.get('topics') or [])}")
            print(f"  allowed actions: {', '.join(meta['allowed_actions'])}")
            print(f"  limits: {meta.get('limits') or {}}")
            print("  HARD BLOCKS (never auto-approved): profile changes, DMs, "
                  "off-mission platforms/topics.")
            print()
            print("To grant, re-run with --confirm. You can revoke anytime with "
                  "`autonomy revoke`.")
            raise UsageError("grant requires --confirm (explicit user confirmation)")
        granted = autonomy_mod.grant(args.mission)
        print(f"autonomy GRANTED for mission {granted['name']!r} at {utcnow()}")
        print("The agent may now act without per-action approval INSIDE mission scope only.")
    elif args.op == "revoke":
        autonomy_mod.revoke()
        print("autonomy revoked. All acting operations need per-action approval again.")
    elif args.op == "status":
        st = autonomy_mod.load_state()
        if not st.get("granted"):
            print("autonomy: not granted")
            return
        m = autonomy_mod.active_mission()
        print(f"autonomy: GRANTED for mission {st.get('mission')!r} "
              f"since {st.get('granted_at')}")
        if m:
            print(f"  platforms: {', '.join(m['platforms'])}; "
                  f"actions: {', '.join(m['allowed_actions'])}")


# ---------------------------------------------------------------- profile ---

PROFILE_FIELDS = ["display_name", "username", "bio", "avatar"]


def _profiles():
    return load_json("profiles.json", {"accounts": {}, "proposals": []})


def cmd_profile(args):
    data = _profiles()
    if args.op == "view":
        acct = resolve_account(args.account)
        prof = data["accounts"].get(acct["username"], {})
        print(f"account : {acct['username']} [{acct['platform']}]")
        for f in PROFILE_FIELDS:
            print(f"{f:13}: {prof.get(f, '-')}")
        pending = [p for p in data["proposals"]
                   if p["account"] == acct["username"] and p["status"] == "proposed"]
        if pending:
            print(f"pending proposals: {', '.join(p['id'] for p in pending)}")
    elif args.op == "update":
        acct = resolve_account(args.account)
        changes = {}
        if args.display_name is not None:
            changes["display_name"] = args.display_name
        if args.username is not None:
            changes["username"] = args.username
        if args.bio is not None:
            changes["bio"] = args.bio
        if args.avatar is not None:
            changes["avatar"] = args.avatar
        if not changes:
            raise UsageError("nothing to change; pass --display-name/--username/--bio/--avatar")
        pid = new_id("pr")
        data["proposals"].append({
            "id": pid, "account": acct["username"], "platform": acct["platform"],
            "changes": changes, "status": "proposed",
            "dry_run": True, "created": utcnow(),
        })
        save_json("profiles.json", data)
        print(f"profile change {pid} PROPOSED for {acct['username']}: {changes}")
        print("HARD RULE: profile changes ALWAYS need an explicit `profile approve` —")
        print("autonomous mode can never auto-approve them.")
    elif args.op == "list":
        items = data["proposals"]
        if args.status:
            items = [p for p in items if p["status"] == args.status]
        if not items:
            print("no profile proposals")
            return
        for p in items:
            print(f"{p['id']} [{p['status']}] {p['account']}: {p['changes']}")
    elif args.op == "approve":
        p = next((x for x in data["proposals"] if x["id"] == args.id), None)
        if not p:
            raise UsageError(f"unknown profile proposal {args.id!r}")
        if p["status"] != "proposed":
            raise UsageError(f"proposal {args.id} is {p['status']}, not proposed")
        # NOTE: autonomy is deliberately NOT consulted here. This command IS the
        # explicit user approval, and there is no code path that auto-approves
        # profile changes.
        guard_acting(p["platform"], "profile")
        p["status"] = "approved"
        p["approved_at"] = utcnow()
        p["approved_at_ts"] = time.time()
        record_action(p["platform"])
        save_json("profiles.json", data)
        print(f"profile change {args.id} APPROVED for {p['account']}")
        print("Apply it in a real browser session, then log it with `profile done`.")
    elif args.op == "done":
        p = next((x for x in data["proposals"] if x["id"] == args.id), None)
        if not p:
            raise UsageError(f"unknown profile proposal {args.id!r}")
        if p["status"] != "approved":
            raise UsageError(f"proposal {args.id} is {p['status']}; approve it first")
        if not approval_valid(p):
            p["status"] = "expired"
            save_json("profiles.json", data)
            raise Refused(f"approval for {args.id} expired; re-approve")
        acct_rec = data["accounts"].setdefault(p["account"], {})
        acct_rec.update(p["changes"])
        p["status"] = "done"
        p["result"] = args.result or "applied in browser session"
        p["done_at"] = utcnow()
        save_json("profiles.json", data)
        print(f"profile change {args.id} logged as done: {p['result']}")


# -------------------------------------------------------------- heartbeat ---

def _watcher_state_last_poll(wid):
    sp = _path(f"watchers/{wid}.json")
    if not os.path.exists(sp):
        return 0
    try:
        with open(sp, encoding="utf-8") as fh:
            ts = json.load(fh).get("state", {}).get("last_poll")
        if not ts:
            return 0
        return datetime.fromisoformat(ts).timestamp()
    except (ValueError, OSError, KeyError):
        return 0


def cmd_heartbeat(args):
    cfg = hb.load_config()
    if args.op == "status":
        print(f"heartbeat: {'enabled' if cfg.enabled else 'disabled'}")
        print(f"base_url: {cfg.base_url or '(log-only mode — no URL configured)'}")
        print(f"supervisor: every {cfg.supervisor_interval}s -> {cfg.supervisor_name}")
        recent = hb.recent_pings(limit=10)
        if not recent:
            print("no pings recorded yet")
            return
        print("recent pings:")
        for r in recent:
            mark = "ok " if r["ok"] else "FAIL"
            print(f"  [{mark}] {r['timestamp']} {r['name']} {r['path']} — {r['detail']}")
    elif args.op == "test":
        if not cfg.base_url:
            print("log-only mode: no base_url configured, pings are recorded locally.")
            print(f"recorded pings: {len(hb.recent_pings(limit=1000))}")
            return
        ok, detail = hb.ping(cfg.base_url, timeout=cfg.timeout, name="heartbeat-test")
        print(f"ping {cfg.base_url}: {'OK' if ok else 'FAILED'} — {detail}")
        if not ok:
            raise UsageError("heartbeat test ping failed")
    elif args.op == "daemon":
        interval = args.interval or cfg.supervisor_interval
        only = [w.strip() for w in args.watchers.split(",")] if args.watchers else None
        poll_interval = get_policy()["watchers"]["poll_interval_seconds"]
        tick = 0
        while True:
            tick += 1
            if cfg.enabled and cfg.supervisor_enabled:
                hb.ping_path(cfg.base_url, cfg.supervisor_name, timeout=cfg.timeout)
            registry = load_json("watchers.json", {})
            for wid in sorted(registry):
                rec = registry[wid]
                if only and wid not in only:
                    continue
                if not rec.get("enabled"):
                    continue
                if time.time() - _watcher_state_last_poll(wid) < poll_interval:
                    continue
                cls = REGISTRY[rec["type"]]
                w = cls(rec["id"], rec["platform"], rec["account"], rec["config"],
                        home_dir(), rec.get("fixture"))
                try:
                    tos_mod.check_tos(rec["platform"], "automated_data_collection")
                except tos_mod.ToSRefusal as e:
                    log_refusal("watch", rec["platform"], rec["id"], f"ToS: {e}")
                    print(f"[tick {tick}] watcher {wid}: REFUSED (ToS): {e}")
                    continue
                try:
                    hb.watch_run(cfg, rec["id"], w.check)
                    print(f"[tick {tick}] watcher {wid}: poll ok")
                except Exception as e:
                    print(f"[tick {tick}] watcher {wid}: FAILED ({e})")
            if args.once:
                break
            time.sleep(interval)


# ----------------------------------------------------------------- doctor ---

def cmd_doctor(args):
    checks = []

    def check(name, ok, detail=""):
        checks.append((name, ok, detail))

    check("python >= 3.8", sys.version_info >= (3, 8), sys.version.split()[0])
    try:
        os.makedirs(home_dir(), exist_ok=True)
        probe = os.path.join(home_dir(), ".writetest")
        with open(probe, "w") as fh:
            fh.write("ok")
        os.remove(probe)
        check("state dir writable", True, home_dir())
    except OSError as e:
        check("state dir writable", False, str(e))
    try:
        pol = get_policy()
        check("policy.yaml parses", True, f"version {pol.get('version')}")
    except Exception as e:
        check("policy.yaml parses", False, str(e))
    for p in SUPPORTED_PLATFORMS:
        try:
            get_adapter(p)
            check(f"platform adapter: {p}", True)
        except Exception as e:
            check(f"platform adapter: {p}", False, str(e))
    try:
        n = 0
        for p in SUPPORTED_PLATFORMS:
            tos_mod.load_rules(p)
            n += 1
        check("ToS rules parse", True, f"{n} platforms")
    except Exception as e:
        check("ToS rules parse", False, str(e))
    check("watcher types", True, ", ".join(sorted(REGISTRY)))
    fx = os.path.join(REPO_ROOT, "watchers", "fixtures")
    nfx = len([f for f in os.listdir(fx) if f.endswith(".json")]) if os.path.isdir(fx) else 0
    check("sample fixtures", nfx > 0, f"{nfx} fixture files")
    check("credentials stored in repo", False, "good: none (by design)")
    try:
        import missions as _m  # noqa: F401
        check("missions module", True, _m.missions_dir())
    except Exception as e:
        check("missions module", False, str(e))
    try:
        from heartbeat import pinger as _hb
        hcfg = _hb.load_config()
        check("heartbeat config", True,
              f"enabled={hcfg.enabled} base_url={'set' if hcfg.base_url else 'log-only'}")
    except Exception as e:
        check("heartbeat config", False, str(e))

    failed = 0
    for name, ok, detail in checks:
        # the credentials check is inverted: ok=False is the desired state
        good = ok if name != "credentials stored in repo" else not ok
        mark = "ok  " if good else "FAIL"
        if not good:
            failed += 1
        print(f"[{mark}] {name}" + (f" — {detail}" if detail else ""))
    if failed:
        raise UsageError(f"{failed} check(s) failed")
    print("doctor: all checks passed")


# ------------------------------------------------------------------- main ---

def build_parser():
    ap = argparse.ArgumentParser(
        prog="social-agent",
        description="Autonomous social-media monitoring toolkit. "
                    "Watchers observe and propose; acting needs explicit approval.")
    ap.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("accounts", help="list/configure accounts (no credentials stored)")
    a_sub = a.add_subparsers(dest="op", required=True)
    a_sub.add_parser("list", help="list configured accounts")
    p = a_sub.add_parser("add", help="add an account")
    p.add_argument("--platform", required=True, help=",".join(SUPPORTED_PLATFORMS))
    p.add_argument("--username", required=True)
    p.add_argument("--label", default="")
    p = a_sub.add_parser("remove", help="remove an account")
    p.add_argument("ref")
    p = a_sub.add_parser("show", help="show account + platform auth notes")
    p.add_argument("ref")
    a.set_defaults(func=cmd_accounts)

    w = sub.add_parser("watch", help="manage poll-based watchers")
    w_sub = w.add_subparsers(dest="op", required=True)
    p = w_sub.add_parser("start", help="start a watcher")
    p.add_argument("--type", required=True, help=",".join(sorted(REGISTRY)))
    p.add_argument("--platform", required=True)
    p.add_argument("--account", required=True)
    p.add_argument("--set", action="append", default=[], help="config key=value (repeatable)")
    p.add_argument("--fixture", default=None, help="JSON fixture file for offline polling")
    p.add_argument("--id", default=None, help="watcher id (generated if omitted)")
    w_sub.add_parser("list", help="list watchers")
    p = w_sub.add_parser("stop", help="stop a watcher")
    p.add_argument("id")
    p = w_sub.add_parser("status", help="watcher status")
    p.add_argument("id", nargs="?")
    p = w_sub.add_parser("run", help="run one poll tick now")
    p.add_argument("id")
    p = w_sub.add_parser("events", help="show recorded events")
    p.add_argument("--watcher", default=None)
    p.add_argument("--limit", type=int, default=20)
    w.set_defaults(func=cmd_watch)

    p_ = sub.add_parser("post", help="draft/queue/approve posts (approval-gated)")
    p_sub = p_.add_subparsers(dest="op", required=True)
    p = p_sub.add_parser("draft", help="draft a post")
    p.add_argument("--platform", required=True)
    p.add_argument("--account", required=True)
    p.add_argument("--text", required=True)
    p.add_argument("--media", default="")
    p.add_argument("--id", default=None)
    p = p_sub.add_parser("queue", help="move draft to queued")
    p.add_argument("id")
    p = p_sub.add_parser("approve", help="approve a post (rate-limited, quiet-hours aware)")
    p.add_argument("id")
    p = p_sub.add_parser("list", help="list posts")
    p.add_argument("--status", default=None)
    p_.set_defaults(func=cmd_post)

    e = sub.add_parser("engage", help="propose/approve/log engagement (dry-run default)")
    e_sub = e.add_subparsers(dest="op", required=True)
    for act in ENGAGE_ACTIONS:
        p = e_sub.add_parser(act, help=f"propose a {act} (dry-run, creates proposal)")
        p.add_argument("--platform", required=True)
        p.add_argument("--account", required=True)
        p.add_argument("--target", required=True, help="post/user/message id or URL")
        p.add_argument("--text", default="", help="comment text (required for comment); "
                                                 "for like: the post's text (for interest scoring)")
        p.add_argument("--author", default="", help="post author's handle (like: cooldown + scoring)")
        p.add_argument("--hashtags", default="", help="comma-separated post hashtags (like: scoring)")
        p.add_argument("--likes-count", type=int, default=None, help="post like count (scoring)")
        p.add_argument("--comments-count", type=int, default=None, help="post comment count (scoring)")
    p = e_sub.add_parser("approve", help="approve a proposed action")
    p.add_argument("id")
    p = e_sub.add_parser("done", help="log an approved action as performed")
    p.add_argument("id")
    p.add_argument("--result", default="")
    p = e_sub.add_parser("list", help="list engagement actions")
    p.add_argument("--status", default=None)
    e.set_defaults(func=cmd_engage)

    m = sub.add_parser("mission", help="define an area of work for autonomous mode")
    m_sub = m.add_subparsers(dest="op", required=True)
    p = m_sub.add_parser("create", help="create a mission file")
    p.add_argument("--name", required=True)
    p.add_argument("--platforms", required=True, help="comma-separated")
    p.add_argument("--topics", default="", help="comma-separated content pillars")
    p.add_argument("--actions", required=True, help="comma-separated allowed actions")
    p.add_argument("--limit", action="append", default=[], help="limit key=value (repeatable)")
    p.add_argument("--brief", default="", help="free-text mission brief")
    m_sub.add_parser("list", help="list missions")
    p = m_sub.add_parser("show", help="show a mission")
    p.add_argument("name")
    m.set_defaults(func=cmd_mission)

    au = sub.add_parser("autonomy", help="grant/revoke scoped autonomous mode")
    au_sub = au.add_subparsers(dest="op", required=True)
    p = au_sub.add_parser("grant", help="grant autonomy for a mission (needs --confirm)")
    p.add_argument("--mission", required=True)
    p.add_argument("--confirm", action="store_true",
                   help="explicit user confirmation after reviewing scope")
    au_sub.add_parser("revoke", help="revoke autonomy immediately")
    au_sub.add_parser("status", help="show autonomy state")
    au.set_defaults(func=cmd_autonomy)

    pr = sub.add_parser("profile", help="view/propose profile changes (approval always required)")
    pr_sub = pr.add_subparsers(dest="op", required=True)
    p = pr_sub.add_parser("view", help="view stored profile")
    p.add_argument("--account", required=True)
    p = pr_sub.add_parser("update", help="propose a profile change (never auto-approved)")
    p.add_argument("--account", required=True)
    p.add_argument("--display-name", default=None)
    p.add_argument("--username", default=None)
    p.add_argument("--bio", default=None)
    p.add_argument("--avatar", default=None, help="local path/URL of new avatar image")
    p = pr_sub.add_parser("approve", help="explicitly approve a profile change")
    p.add_argument("id")
    p = pr_sub.add_parser("done", help="log an approved profile change as applied")
    p.add_argument("id")
    p.add_argument("--result", default="")
    p = pr_sub.add_parser("list", help="list profile proposals")
    p.add_argument("--status", default=None)
    pr.set_defaults(func=cmd_profile)

    hb_p = sub.add_parser("heartbeat", help="heartbeat monitoring (protocol-compatible)")
    hb_sub = hb_p.add_subparsers(dest="op", required=True)
    hb_sub.add_parser("status", help="show heartbeat config + recent pings")
    hb_sub.add_parser("test", help="test-ping the configured base URL")
    p = hb_sub.add_parser("daemon", help="supervisor loop: heartbeat + due watcher polls")
    p.add_argument("--interval", type=int, default=None, help="seconds between ticks")
    p.add_argument("--once", action="store_true", help="single tick then exit")
    p.add_argument("--watchers", default="", help="comma-separated watcher ids (default: all due)")
    hb_p.set_defaults(func=cmd_heartbeat)

    r = sub.add_parser("research", help="build a cross-platform topic research plan")
    r.add_argument("topic")
    r.add_argument("--platforms", default="",
                   help="comma-separated subset (default: all)")
    r.set_defaults(func=cmd_research)

    n = sub.add_parser("analytics", help="engagement summaries from watcher state")
    n.add_argument("--watcher", default=None)
    n.add_argument("--days", type=int, default=None)
    n.set_defaults(func=cmd_analytics)

    d = sub.add_parser("doctor", help="environment checks")
    d.set_defaults(func=cmd_doctor)

    return ap


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        args.func(args)
    except tos_mod.ToSRefusal as e:
        print(f"REFUSED (ToS): {e}", file=sys.stderr)
        return 2
    except Refused as e:
        print(f"REFUSED (policy): {e}", file=sys.stderr)
        return 2
    except UsageError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    except WatcherError as e:
        print(f"watcher error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
